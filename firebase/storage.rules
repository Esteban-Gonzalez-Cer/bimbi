rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/phase1/probe.png {
      function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
      allow read, delete: if owner();
      allow create, update: if owner() && request.resource.size <= 2048 && request.resource.contentType == 'image/png';
    }
  }
}
